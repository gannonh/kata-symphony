{
  "name": "@kata/shared",
  "version": "0.6.0",
  "license": "MIT",
  "description": "Shared business logic for Kata - agent, auth, config, credentials, MCP integration",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint src/ --max-warnings=150",
