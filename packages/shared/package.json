  },
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent/index.ts",
    "./agent/modes": "./src/agent/mode-types.ts",
    "./agent/mode-types": "./src/agent/mode-types.ts",
    "./agent/thinking-levels": "./src/agent/thinking-levels.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/callback-page": "./src/auth/callback-page.ts",
    "./auth/types": "./src/auth/types.ts",
    "./config": "./src/config/index.ts",
    "./docs": "./src/docs/index.ts",
    "./docs/doc-links": "./src/docs/doc-links.ts",
    "./config/types": "./src/config/types.ts",
    "./credentials": "./src/credentials/index.ts",
    "./headless": "./src/headless/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./prompts": "./src/prompts/index.ts",
    "./sessions": "./src/sessions/index.ts",
    "./sources": "./src/sources/index.ts",
    "./sources/types": "./src/sources/types.ts",
    "./workspaces": "./src/workspaces/index.ts",
