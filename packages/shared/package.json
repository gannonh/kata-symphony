    "filtrex": "^3.1.0",
    "glob": "^13.0.6",
    "incr-regex-package": "^1.0.4",
    "shell-quote": "^1.10.0",
    "simple-git": "^3.30.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.19",
    "@anthropic-ai/sdk": ">=0.70.0",
    "@modelcontextprotocol/sdk": ">=1.0.0",
    "zod": ">=3.0.0"
  },
  "devDependencies": {
    "@types/shell-quote": "^1.7.5",
    "vitest": "^4.1.11"
